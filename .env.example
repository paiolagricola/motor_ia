# Chave da API da Anthropic (https://console.anthropic.com)
# Alternativa: rode `claude setup-token` ou `ant auth login` e deixe em branco.
ANTHROPIC_API_KEY=

# Modelo usado para ESTRUTURAR o pedido (barato e rápido).
# Troque para claude-opus-4-8 se quiser specs mais elaboradas.
STRUCTURER_MODEL=claude-haiku-4-5

# Modelo usado pelo Claude Code para EXECUTAR (deixe vazio para usar o padrão do Claude Code)
EXECUTOR_MODEL=

# Porta do painel do Motor IA
PORT=4000
