# ── Autenticação ──────────────────────────────────────────────────────────
# O motor funciona de DOIS jeitos. Escolha um:
#
# 1) ASSINATURA (Claude Pro/Max — recomendado se você já paga a assinatura):
#    Deixe ANTHROPIC_API_KEY em branco e faça login no Claude Code uma vez:
#       npx @anthropic-ai/claude-code /login
#    Tudo roda dentro dos limites do seu plano, SEM cobrança por token.
#
# 2) API (chave sk-ant-..., cobrança por uso):
#    Preencha a chave abaixo (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Modelo do ESTRUTURADOR (pedido → spec).
# - Modo API: padrão claude-haiku-4-5 (centavos por spec).
# - Modo assinatura: deixe vazio para usar o modelo padrão do seu plano.
STRUCTURER_MODEL=

# Modelo do EXECUTOR (Claude Code). Vazio = padrão do Claude Code.
EXECUTOR_MODEL=

# Porta do painel do Motor IA
PORT=4000
